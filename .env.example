# Lead Generation Pipeline - example environment configuration.
# Copy to .env and adjust. Nested settings use a double-underscore delimiter
# (GROUP__FIELD); top-level settings have no prefix.

# --- Project ---
PROJECT_NAME="Lead Generation Pipeline"
INPUT_URLS_CSV="./data/urls_seed.csv"
MAX_PIPELINE_CONCURRENCY=5
MAX_CONCURRENT_REQUESTS_PER_DOMAIN=1

# --- Database ---
DATABASE__DATABASE_URL="sqlite+aiosqlite:///./data/leads.db"
DATABASE__ECHO_SQL=false

# --- Crawler ---
CRAWLER__DEFAULT_TIMEOUT_SECONDS=30
CRAWLER__MIN_DELAY_PER_DOMAIN_SECONDS=3.0
CRAWLER__MAX_DELAY_PER_DOMAIN_SECONDS=10.0
CRAWLER__MAX_RETRIES=3
CRAWLER__USE_PLAYWRIGHT_BY_DEFAULT=false
CRAWLER__PLAYWRIGHT_HEADLESS_MODE=true
CRAWLER__RESPECT_ROBOTS_TXT=true
CRAWLER__ROBOTS_TXT_USER_AGENT="*"
# CRAWLER__HTTP_PROXY_URL="http://user:pass@proxy:8080"
# CRAWLER__HTTPS_PROXY_URL="http://user:pass@proxy:8080"

# --- Logging ---
LOGGING__LOG_LEVEL="INFO"
LOGGING__LOG_FILE_PATH="./logs/app.log"
LOGGING__ERROR_LOG_FILE_PATH="./logs/error.log"

# --- Local LLM (chamber-directory processing) ---
LLM__MODEL_PATH="./models/qwen2-7b-instruct-q4_k_m.gguf"
LLM__CONTEXT_SIZE=32768
LLM__MAX_TOKENS=4096
LLM__TEMPERATURE=0.0
LLM__N_GPU_LAYERS=-1
